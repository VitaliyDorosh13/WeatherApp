    def create_visualization_panel(self, parent):
        # Notebook for different visualizations
        self.notebook = ttk.Notebook(parent)
        self.notebook.pack(fill='both', expand=True, padx=10, pady=10)
        
        # Tab 1: Historical Data
        self.tab1 = tk.Frame(self.notebook, bg='white')
        self.notebook.add(self.tab1, text='📊 Historical Data')
        
        # Tab 2: Model Performance
        self.tab2 = tk.Frame(self.notebook, bg='white')
        self.notebook.add(self.tab2, text='🎯 Model Performance')
        
