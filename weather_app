    def fetch_data_thread(self):
        thread = threading.Thread(target=self.fetch_data)
        thread.start()
        
    def fetch_data(self):
        try:
            self.status_var.set("Fetching weather data...")
            self.root.update()
            
            latitude = float(self.lat_entry.get())
            longitude = float(self.lon_entry.get())
            days = int(self.days_entry.get())
            
            end_date = datetime.now().date()
            start_date = end_date - timedelta(days=days)
            
            url = "https://archive-api.open-meteo.com/v1/archive"
            params = {
                "latitude": latitude,
                "longitude": longitude,
                "start_date": start_date.strftime("%Y-%m-%d"),
                "end_date": end_date.strftime("%Y-%m-%d"),
                "daily": "temperature_2m_max,temperature_2m_min,temperature_2m_mean,precipitation_sum,windspeed_10m_max,shortwave_radiation_sum",
                "timezone": "auto"
            }
            
            response = requests.get(url, params=params, timeout=30)
            response.raise_for_status()
            data = response.json()
            
            self.data = pd.DataFrame({
                'date': pd.to_datetime(data['daily']['time']),
                'temp_max': data['daily']['temperature_2m_max'],
                'temp_min': data['daily']['temperature_2m_min'],
                'temp_mean': data['daily']['temperature_2m_mean'],
                'precipitation': data['daily']['precipitation_sum'],
                'wind_speed': data['daily']['windspeed_10m_max'],
                'solar_radiation': data['daily']['shortwave_radiation_sum']
            })
            
            self.status_var.set(f"✓ Successfully loaded {len(self.data)} days of data")
            self.visualize_historical_data()
            messagebox.showinfo("Success", f"Loaded {len(self.data)} days of weather data!")
            
        except Exception as e:
            self.status_var.set("✗ Error fetching data")
            messagebox.showerror("Error", f"Failed to fetch data: {str(e)}")
    
    def load_excel(self):
        try:
            filepath = filedialog.askopenfilename(
                title="Select Excel File",
                filetypes=[("Excel files", "*.xlsx *.xls")]
            )
            if filepath:
                self.data = pd.read_excel(filepath)
                self.data['date'] = pd.to_datetime(self.data['date'])
                self.status_var.set(f"✓ Loaded {len(self.data)} records from Excel")
                self.visualize_historical_data()
                messagebox.showinfo("Success", f"Loaded {len(self.data)} records!")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to load Excel: {str(e)}")
    
    def save_excel(self):
        if self.data is None:
            messagebox.showwarning("Warning", "No data to save!")
            return
        
        try:
            filepath = filedialog.asksaveasfilename(
                defaultextension=".xlsx",
                filetypes=[("Excel files", "*.xlsx")]
            )
            if filepath:
                self.data.to_excel(filepath, index=False)
                messagebox.showinfo("Success", "Data saved successfully!")
                self.status_var.set(f"✓ Data saved to {filepath}")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save: {str(e)}")
    
